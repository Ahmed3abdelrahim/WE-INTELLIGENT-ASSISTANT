# Copy to .env and adjust. .env is git-ignored and never committed.

# --- LLM provider: local (default, CPU), local+GPU (compose.gpu.yaml), openrouter (compose.cloud.yaml) ---
LLM_PROVIDER=local
LLM_LOCAL_URL=http://llm:8080/v1
LLM_LOCAL_MODEL=qwen3-4b-q4_k_m
LLM_THREADS=8
# llama-server slots share one KV pool: LLM_CTX_TOTAL must be LLM_PARALLEL x 4096, or
# simultaneous users fail with "Context size has been exceeded". q8_0 halves KV memory.
LLM_PARALLEL=4
LLM_CTX_TOTAL=16384
LLM_KV_TYPE=q8_0
LLM_CACHE_RAM=1024

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-4b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- ASR (faster-whisper) ---
ASR_MODEL=large-v3-turbo
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- Retrieval ---
# On: better ranking + the evidence gate (config/settings.yaml min_rerank_score). Cheap on a GPU
# (native: EMBED_DEVICE=cuda), a few seconds per question on CPU.
RERANKER_ENABLED=false
EMBED_DEVICE=cpu
